---
import { tagUrl } from "../../lib/tags";
import { publishedPosts as getPublishedPosts } from "../../lib/posts";

import Layout from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

const publishedPosts = await getPublishedPosts();
const tags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags ?? []).filter(Boolean)),
);
---

<Layout title="Tags">
	<section>
		<h1 class="text-3xl font-bold mb-12">Tags</h1>
		<div class="flex flex-wrap gap-2 mt-12">
			{
				tags.sort().map((tag) => {
					return (
						<a
							href={tagUrl(tag)}
							class="bg-inactive-background text-inactive-foreground text-xs font-semibold mr-2 px-2.5 py-0.5 rounded hover:text-white hover:bg-primary hover:scale-105 transition-transform"
						>
							<span class="text-lg font-bold">
								<Icon name="tag"/>{tag}
							</span>
						</a>
					);
				})
			}
		</div>
	</section>
</Layout>
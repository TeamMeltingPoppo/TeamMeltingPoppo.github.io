---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

type Props = {
	title: string;
	image?: ImageMetadata;
	description?: string;
	wordpress?: Record<string, unknown>;
};

const { title, image, description, wordpress } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		{process.env.WORDPRESS_SITE_URL && <script is:inline type="application/json" id="swingby-wp-data" set:html={JSON.stringify({title, ...wordpress}).replace(/</g, '\\u003c')} />}
		<BaseHead
			title={`${title} - ${SITE_TITLE}`}
			image={image}
			description={description || SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />
		<main class="mb-8 max-w-[calc(100%)] mx-auto">
			<div class="container mx-auto py-4">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>

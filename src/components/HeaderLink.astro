---
import type { HTMLAttributes } from 'astro/types';
import '../styles/global.css';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
---

<a href={href} {...props} class:list={["block whitespace-nowrap rounded-md px-3 py-3 font-medium hover:bg-foreground hover:text-background", className]}>
	<slot/>
</a>

---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import siteSettings from "../data/site-settings.json";
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../consts";
import logo from "../assets/logo.png";

interface Props {
	title: string;
	image?: ImageMetadata;
    imageURL?: string;
	description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, image, imageURL, description } = Astro.props;
const fields = siteSettings.fields;
if (![fields.light_primary.value, fields.dark_primary.value].every(value => /^#[0-9a-f]{6}$/i.test(value))) throw new Error("Invalid site color");
if (!Number.isFinite(fields.article_width.value) || fields.article_width.value < 560 || fields.article_width.value > 960 || !Number.isFinite(fields.article_font_size.value) || fields.article_font_size.value < 14 || fields.article_font_size.value > 20) throw new Error("Invalid article sizing");
const settingsCSS = `html.light,html:not(.dark){--color-primary:${fields.light_primary.value}}html.dark{--color-primary:${fields.dark_primary.value}}html .blog-article{max-width:${fields.article_width.value}px}html #article-content,html #article-content p,html #article-content li{font-size:${fields.article_font_size.value}px}`;
---

<script is:inline>
    (() => {
        let theme;
        try { theme = localStorage.getItem("theme"); } catch {}
        const dark = theme === "dark" || (theme !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.classList.toggle("light", !dark);
    })();
</script>
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/logo.png" type="image/png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{description ? <meta name="description" content={description} /> : null}

<!-- Google site verification -->
<meta name="google-site-verification" content="2X59wfMbUNnhABKeMN4kK6vv9vnac2cTtAHftMUjasY" />

<!-- Open Graph / Facebook -->
<meta prefix="og: http://ogp.me/ns#" />
<meta property="og:title" content={title} />
<meta property="og:site_name" content={SITE_TITLE} />
{
	description ? <meta property="og:description" content={description} /> : null
}
<meta property="og:type" content="website" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL.toString()} />
{
	imageURL || image ? (
		<meta
			property="og:image"
			content={imageURL || new URL(image!.src, Astro.site).toString()}
		/>
	) : (
		<meta
			property="og:image"
			content={new URL(logo.src, Astro.site).toString()}
		/>
	)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:url" content={canonicalURL.toString()} />
{
	imageURL || image ? (
		<meta
			name="twitter:image"
			content={imageURL || new URL(image!.src, Astro.site).toString()}
		/>
	) : (
		<meta
			name="twitter:image"
			content={new URL(logo.src, Astro.site).toString()}
		/>
	)
}
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:creator" content="@melting_poppo" />

<!-- Font preloads -->
<!-- <link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin /> -->
<!-- <link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin /> -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
{description ? <meta name="description" content={description} /> : null}
<style is:inline set:html={settingsCSS} />
